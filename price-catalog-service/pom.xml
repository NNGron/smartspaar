<?xml version="1.0" encoding="UTF-8"?>
<!-- Price Catalog: store prices in Postgres -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.smartspaar</groupId>
		<artifactId>smartspaar</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<!-- Why: link to parent pom in root -->
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>price-catalog-service</artifactId>
	<name>price-catalog-service</name>

	<dependencies>
		<!-- Why: REST controller -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- Why: JPA for Postgres -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Why: Postgres driver -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>
		<!-- Why: Flyway DB migrations -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
			<version>10.8.0</version>
		</dependency>
		<!-- Why: use shared DTOs (PriceBulkRequest, ProductDto, SearchResponse) -->
		<dependency>
			<groupId>com.smartspaar</groupId>
			<artifactId>common-model</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- Why: unit tests (JUnit 5 + Spring Boot Test) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Why: Swagger UI for REST testing -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.6.0</version>
		</dependency>

		<!-- Why: use H2 in tests -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
<!--			<scope>test</scope>-->
		</dependency>

		<!-- Why: Bean Validation provider -->
		<dependency>
			<groupId>org.hibernate.validator</groupId>
			<artifactId>hibernate-validator</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Why: package executable Spring Boot jar -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>