<?xml version="1.0" encoding="UTF-8"?>
<!-- Aggregator: Spring Boot REST + Feign + Redis -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.smartspaar</groupId>
		<artifactId>smartspaar</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<!-- Why: link to parent pom in root -->
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>aggregator-service</artifactId>
	<name>aggregator-service</name>

	<dependencies>
		<!-- Why: build REST endpoints -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Why: call store services by HTTP (Feign) -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-openfeign</artifactId>
		</dependency>

		<!-- Why: cache results in Redis -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- Why: share DTOs from common module -->
		<dependency>
			<groupId>com.smartspaar</groupId>
			<artifactId>common-model</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- Why: health/metrics (optional) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Why: unit tests (JUnit 5 + Spring Boot Test) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Why: Swagger UI for REST testing -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.6.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Why: package executable Spring Boot jar -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>